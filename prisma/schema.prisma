generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model carrito {
  id_carrito      Int               @id @default(autoincrement())
  id_cliente      Int
  fecha           DateTime          @db.Timestamp(6)
  estado          String            @db.VarChar(20)
  clientes        clientes          @relation(fields: [id_cliente], references: [id_cliente], onDelete: NoAction, onUpdate: NoAction)
  detalle_carrito detalle_carrito[]
  ventas          ventas?
}

model categorias {
  id_categoria Int         @id @default(autoincrement())
  nombre       String      @unique @db.VarChar(100)
  descripcion  String?     @db.VarChar(255)
  productos    productos[]
}

model clientes {
  id_cliente Int       @id @default(autoincrement())
  id_usuario Int?      @unique
  nombres    String    @db.VarChar(100)
  apellidos  String    @db.VarChar(100)
  telefono   String?   @db.VarChar(25)
  direccion  String?   @db.VarChar(255)
  carrito    carrito[]
  usuarios   usuarios? @relation(fields: [id_usuario], references: [id_usuario], onDelete: NoAction, onUpdate: NoAction)
  ventas     ventas[]
}

model detalle_carrito {
  id_detalle_carrito Int       @id @default(autoincrement())
  id_carrito         Int
  id_producto        Int
  cantidad           Int
  carrito            carrito   @relation(fields: [id_carrito], references: [id_carrito], onDelete: NoAction, onUpdate: NoAction)
  productos          productos @relation(fields: [id_producto], references: [id_producto], onDelete: NoAction, onUpdate: NoAction)

  @@unique([id_carrito, id_producto])
}

model detalle_metodo_pago {
  id_detalle_metodo_pago Int          @id @default(autoincrement())
  id_venta               Int
  id_metodo_pago         Int
  monto                  Decimal      @db.Decimal(12, 2)
  referencia             String?      @db.VarChar(100)
  fecha                  DateTime     @db.Timestamp(6)
  metodos_pago           metodos_pago @relation(fields: [id_metodo_pago], references: [id_metodo_pago], onDelete: NoAction, onUpdate: NoAction)
  ventas                 ventas       @relation(fields: [id_venta], references: [id_venta], onDelete: NoAction, onUpdate: NoAction)
}

model detalle_ventas {
  id_detalle_venta Int       @id @default(autoincrement())
  id_venta         Int
  id_producto      Int
  cantidad         Int
  precio_unitario  Decimal   @db.Decimal(12, 2)
  productos        productos @relation(fields: [id_producto], references: [id_producto], onDelete: NoAction, onUpdate: NoAction)
  ventas           ventas    @relation(fields: [id_venta], references: [id_venta], onDelete: NoAction, onUpdate: NoAction)

  @@unique([id_venta, id_producto])
}

model metodos_pago {
  id_metodo_pago      Int                   @id @default(autoincrement())
  nombre              String                @unique @db.VarChar(50)
  detalle_metodo_pago detalle_metodo_pago[]
}

model productos {
  id_producto     Int               @id @default(autoincrement())
  id_categoria    Int
  codigo          String            @unique @db.VarChar(50)
  nombre          String            @db.VarChar(150)
  precio          Decimal           @db.Decimal(12, 2)
  stock           Int               @default(0)
  detalle_carrito detalle_carrito[]
  detalle_ventas  detalle_ventas[]
  categorias      categorias        @relation(fields: [id_categoria], references: [id_categoria], onDelete: NoAction, onUpdate: NoAction)
}

model usuarios {
  id_usuario     Int       @id @default(autoincrement())
  nombre_usuario String    @unique @db.VarChar(50)
  correo         String    @unique @db.VarChar(150)
  contrasena     String    @db.VarChar(255)
  rol            String    @db.VarChar(20)
  clientes       clientes?
  ventas         ventas[]
}

model ventas {
  id_venta            Int                   @id @default(autoincrement())
  id_cliente          Int
  id_usuario          Int
  id_carrito          Int?                  @unique
  fecha               DateTime              @db.Timestamp(6)
  total               Decimal               @db.Decimal(12, 2)
  estado              String                @db.VarChar(20)
  detalle_metodo_pago detalle_metodo_pago[]
  detalle_ventas      detalle_ventas[]
  carrito             carrito?              @relation(fields: [id_carrito], references: [id_carrito], onDelete: NoAction, onUpdate: NoAction)
  clientes            clientes              @relation(fields: [id_cliente], references: [id_cliente], onDelete: NoAction, onUpdate: NoAction)
  usuarios            usuarios              @relation(fields: [id_usuario], references: [id_usuario], onDelete: NoAction, onUpdate: NoAction)
}
